DirectoryIndex index.html
ErrorDocument 404 /404.html


#RewriteEngine On 
#RewriteCond %{HTTP_HOST} ^takenotereviews\.com [NC] 
#RewriteCond %{SERVER_PORT} 80 
#RewriteRule ^(.*)$ https://www.takenotereviews.com/$1 [R,L]



RewriteEngine on

RewriteCond %{HTTP_HOST} ^takenotereviews.com [NC]
RewriteRule ^(.*)$ http://www.takenotereviews.com/$1 [L,R=301,NC]

RewriteCond %{ENV:HTTPS} !=on
RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI} [R,L]